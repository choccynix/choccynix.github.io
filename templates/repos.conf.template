# ◈ /etc/portage/repos.conf/choccynix.conf
#
# Adds this repo as a Gentoo ebuild overlay (separate concern from the
# binary package binhost — see binrepos.conf.template for that). Use this
# if/when real custom ebuilds get added here; an empty overlay with no
# ebuilds yet is still valid to sync, it just won't provide any packages.

[choccynix]
location = /var/db/repos/choccynix
sync-type = git
sync-uri = https://github.com/choccynix/choccynix.github.io.git
auto-sync = yes
priority = 50
