# ◈ /etc/portage/binrepos.conf/choccynix.conf
#
# Points at this repo's own GitHub Pages hosting (a <username>.github.io
# repo — Pages is served automatically from its root with no settings
# toggle needed, unlike a regular repo's gh-pages branch, which has to be
# manually enabled and previously wasn't).
#
# The actual .gpkg.tar package blobs still live on athanor-binpkgs'
# GitHub Releases — this URL only needs to serve the lightweight Packages
# index; each entry in it carries its own absolute URI to the real blob.

[choccynix]
priority = 9999
sync-uri = https://choccynix.github.io

# Portage >=3.0.74 defaults this to true, expecting its own gemato-based
# signature scheme — not the plain detached GPG .sig file published here
# (see docs/package-signing.md in athanor-binpkgs). Leaving the default on
# would very likely just fail against this binhost.
verify-signature = false
